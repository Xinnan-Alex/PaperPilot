// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "label": "Python Debugger: FastAPI",
    "adapter": "Debugpy",
    "request": "launch",
    "cwd": "$ZED_WORKTREE_ROOT/backend/",
    "module": "uvicorn",
    "args": ["paperpilot.api:app", "--reload", "--port", "8000"],
    "python": "$ZED_WORKTREE_ROOT/backend/.venv/bin/python",
    "env": { "PYTHONPATH": "$ZED_WORKTREE_ROOT/backend/src" },
  },
]
