ENV=local
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SECRET_KEY=sb_secret_<...>
SUPABASE_DB_URL=postgresql://postgres.<project>:<pw>@<host>:6543/postgres?sslmode=require
SUPABASE_STORAGE_BUCKET=documents
DEEPSEEK_API_KEY=<from DeepSeek>
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
VOYAGE_API_KEY=<from Voyage>
EMBEDDING_MODEL=voyage-3-lite
EMBEDDING_DIM=512
OCR_LANGUAGE=eng
FRONTEND_ORIGINS=http://localhost:5173,https://paperpilot.leongxinnan.com
# Eval judge model (separate provider from reader to avoid self-preference bias)
JUDGE_MODEL=gpt-4o-mini
JUDGE_BASE_URL=https://api.openai.com/v1
JUDGE_API_KEY=<your-openai-key>

# LLM provider keys (set any subset; only set models appear in /models)
OPENAI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# Tool keys
TAVILY_API_KEY=

# Agent defaults
DEFAULT_MODEL_ID=deepseek-chat
AGENT_MAX_ITERATIONS=5
